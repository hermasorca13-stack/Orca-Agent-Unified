# ORCA Max Mouny — trading configuration
# Copy to .env.orca and keep it outside version control.
ORCA_TRADING_MODE=paper
# Leave empty unless a deliberate live activation is performed outside Git.
ORCA_LIVE_CONFIRM=
ORCA_STATE_DIR=data/orca_max_mouny
ORCA_AUDIT_LOG=data/orca_max_mouny/audit.jsonl
ORCA_DATABASE=data/orca_max_mouny/orca.sqlite3
ORCA_CREDENTIAL_EXCHANGES=binance,coinbase,kraken
ORCA_ACTIVE_EXCHANGES=
ORCA_MAX_ORDER_RISK_PCT=0.01
ORCA_MIN_ORDER_RISK_PCT=0.005
ORCA_MAX_DAILY_LOSS_PCT=0.02
ORCA_MAX_MONTHLY_LOSS_PCT=0.02

# Paper engine has no exchange secret and is safe to run with the defaults.
# For sandbox/testnet, use credentials created on the exchange test network.
ORCA_BINANCE_SANDBOX=1
ORCA_BINANCE_API_KEY=
ORCA_BINANCE_API_SECRET=
ORCA_BINANCE_PASSWORD=
ORCA_BINANCE_UID=
ORCA_BINANCE_ENABLE_WITHDRAW=0

ORCA_COINBASE_SANDBOX=1
ORCA_COINBASE_API_KEY=
ORCA_COINBASE_API_SECRET=
ORCA_COINBASE_PASSWORD=
ORCA_COINBASE_UID=
ORCA_COINBASE_ENABLE_WITHDRAW=0

ORCA_KRAKEN_SANDBOX=1
ORCA_KRAKEN_API_KEY=
ORCA_KRAKEN_API_SECRET=
ORCA_KRAKEN_PASSWORD=
ORCA_KRAKEN_UID=
ORCA_KRAKEN_ENABLE_WITHDRAW=0
