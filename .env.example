# Orca Agent — Example Environment
# Copy to .env and fill in real values. Never commit .env.

# ===== Telegram =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=HermesOrcaXBot
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
TELEGRAM_BOT_HASH=

# ===== GitHub =====
GITHUB_USERNAME=
GITHUB_EMAIL=
GITHUB_REPO=Orca-Agent-Unified
GITHUB_BRANCH=master
GITHUB_TOKEN=

# ===== Orca Master (tier-0 universal) =====
ORCA_MASTER_TOKEN=
ORCA_UNIVERSAL_KEY=

# ===== LLM (Brain) — fill ONE to enable /agent =====
LLM_PROVIDER=anthropic
LLM_MODEL=claude-3-5-sonnet-20241022
LLM_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ===== Runtime =====
RUN_MODE=production
LOG_LEVEL=INFO
PORT=8080
