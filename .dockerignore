# .dockerignore — keep the image lean
.git
.gitignore
.github
.idea
.vscode
__pycache__
*.py[cod]
*$py.class
*.so
*.egg-info
*.egg
.pytest_cache
.coverage
htmlcov
.tox
.hypothesis

# Local state
.env
*.db
*.sqlite
*.sqlite3
logs/
data/
backups/
faiss_index/
.index/

# Tests aren't needed in prod image
tests/

# Docs (already on GitHub)
*.md
LICENSE

# Node leftovers
node_modules/
package*.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS junk
.DS_Store
Thumbs.db
